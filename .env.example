# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — it will NOT be pushed to GitHub.
#
# You do NOT put AWS keys here. Keys live in ~/.aws/credentials
# via `aws configure`. This file is only for non-secret settings.

CLOUDSNARE_REGION=ap-south-1
CLOUDSNARE_ALERT_EMAIL=YOUR_EMAIL@example.com
