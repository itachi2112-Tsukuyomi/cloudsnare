# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — it will NOT be pushed to GitHub.
#
# You do NOT put AWS keys here. Keys live in ~/.aws/credentials
# via `aws configure`. This file is only for non-secret settings.

CLOUDSNARE_REGION=ap-south-1
CLOUDSNARE_ALERT_EMAIL=YOUR_EMAIL@example.com

# ---- LLM provider (SOC Chat + Cloud Assistant) ------------------------------
# Optional. Without a key the SOC Chat still retrieves and shows the matching
# records ("retrieval-only" mode); the Cloud Assistant needs a key to run.
#
# Default provider is OpenRouter, and the default model is free:
#   get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# To use Claude instead, set the provider and an Anthropic key:
# CLOUDSNARE_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
